# ─────────────────────────────────────────────────────────────
#  ManzxyOTP — Environment Config
# ─────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────
BOT_TOKEN=TOKEN_LU

# �── Ditznesia (provider OTP) ──────────────────────────────────
# API key ada di dashboard Ditznesia → API Docs
DITZNESIA_KEY=APIKEY_LU
# Opsional — hanya isi kalau Ditznesia pindah domain, default sudah benar
# DITZNESIA_BASE_URL=https://www.ditznesia.com/api/dev
# Opsional — server yang ditampilkan ke user (default 1,2,3,4,5)
# DITZNESIA_SERVERS=1,2,3,4,5

# ── KiPay Payment Gateway (QRIS) ──────────────────────────────
# Daftar & buat project di https://kipay.id/login
# Docs: https://kipay.id/docs/api — pakai API key sandbox dulu untuk testing
# (trx_id sandbox berprefiks SBX-, production berprefiks QRIS-)
KIPAY_API_KEY=APIKEYLU

# Durasi QRIS berlaku (menit) — HANYA fallback lokal, KiPay yang menentukan
# expires_at sebenarnya lewat response API. Default 30.
QRIS_EXPIRY_MINUTES=30

# ── Admin ─────────────────────────────────────────────────────
# Pisahkan dengan koma jika lebih dari 1 admin
ADMIN_IDS=ID_LU
ADMIN_USERNAME=USERNAME_LU

# ── Log Channel ───────────────────────────────────────────────
# chat_id channel/grup log (awali minus untuk channel/grup)
# Kosongkan jika tidak mau pakai log channel
LOG_CHANNEL_ID=-

# ── Markup harga OTP (persen) ─────────────────────────────────
# 0 = tidak ada markup, 10 = harga naik 10%
PRICE_MARKUP=10

# ── Expire order otomatis (menit) ─────────────────────────────
ORDER_EXPIRE_MINUTES=20

# ── Maintenance window ────────────────────────────────────────
# true = aktifkan maintenance otomatis sesuai jam
MAINTENANCE_ENABLED=true
# Jam mulai maintenance (WIB, 0-23) — default 23 = jam 23:00
MAINTENANCE_START_HOUR=23
# Jam selesai maintenance (WIB, 0-23) — default 1 = jam 01:00
MAINTENANCE_END_HOUR=1
# Pesan custom saat maintenance (opsional)
MAINTENANCE_MESSAGE=

# ── Auto-Topup RumahOTP ───────────────────────────────────────
# true = bot notif admin otomatis saat saldo RumahOTP menipis
AUTO_TOPUP_ENABLED=false
# Saldo minimum RumahOTP sebelum trigger notif (Rupiah)
AUTO_TOPUP_THRESHOLD=50000
# Nominal topup yang disarankan (Rupiah)
AUTO_TOPUP_AMOUNT=200000
# Interval cek saldo RumahOTP (menit)
AUTO_TOPUP_INTERVAL_MIN=30

# ── Wajib Join Channel ────────────────────────────────────────
# Format: "channelId,NamaChannel,https://t.me/link"
# Pisahkan dengan | jika lebih dari 1 channel
# channelId = @username atau chat_id numerik
# PENTING: Bot harus jadi admin di channel tersebut!
#
# Contoh 1 channel:
# REQUIRED_CHANNELS=@namaChannel,Channel Utama,https://t.me/namaChannel
#
# Contoh 2 channel:
# REQUIRED_CHANNELS=
#
REQUIRED_CHANNELS=LIAT_CONTOH_DIATAS_YA_NYET

# Foto/sticker yang dikirim bareng pesan wajib join (opsional)
# Bisa berupa file_id Telegram atau URL publik
JOIN_PROMPT_PHOTO=

# ── Harga Khusus Admin/Owner ──────────────────────────────────────────────
# Markup berbeda untuk admin (biasanya lebih kecil/0 = harga modal)
# Kosongkan atau 0 = admin beli dengan harga modal asli (tanpa markup)
PRICE_MARKUP_ADMIN=0

# ── Referral ────────────────────────────────────────────────────────────────
# Bonus saldo (Rp) yang didapat referrer setiap user baru start bot via link referralnya
REFERRAL_BONUS=150


# ── Mode MD: limit harian per user ───────────────────────────────────────────
# Jatah limit per hari (reset otomatis jam 00:00 sesuai zona waktu).
# Tiap fitur memotong limit sesuai biayanya (mis. .tiktok = 1 limit).
MD_LIMIT_FREE=10
MD_LIMIT_PREMIUM=20
MD_TIMEZONE=Asia/Jakarta

# ── Beli OTP cepat ────────────────────────────────────────────
# Aplikasi populer di tombol "Beli OTP" (nama layanan Ditznesia, pisah koma)
QUICK_SERVICES=whatsapp,telegram,instagram,facebook,tiktok,twitter
# Negara default untuk rekomendasi server otomatis
QUICK_COUNTRY=indonesia
# Jeda auto-cek OTP masuk (detik) — OTP dikirim otomatis ke user
OTP_POLL_SEC=6
